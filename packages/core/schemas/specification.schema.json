  "description": "The flat YAML and API representation of a Specification.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "default": "",
      "title": "Id",
      "type": "string"
    },
    "runner_factory_ref": {
      "default": "metis.engine.simulation.runners.http.HttpRunnerFactory",
      "title": "Runner Factory Ref",
      "type": "string"
    },
    "target_binding": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Binding"
    },
    "defaults": {
      "$ref": "#/$defs/ExperimentDefaults"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "title": "Features",
      "type": "array"
    },
    "personas": {
      "items": {
        "$ref": "#/$defs/Persona"
      },
      "title": "Personas",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "title": "Tasks",
      "type": "array"
    },
    "fixture_content_descriptions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Fixture Content Descriptions",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "runner_factory_ref",
    "target"
  ],
  "title": "Specification v1",
  "type": "object"
}
