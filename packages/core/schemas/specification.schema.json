        "judge_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Model"
        },
        "user_agent_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Agent Model"
        },
        "runner_agent_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Agent Model"
        }
      },
      "title": "ExperimentDefaults",
      "type": "object"
    },
    "Feature": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
