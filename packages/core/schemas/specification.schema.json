        "id",
        "name",
        "description"
      ],
      "title": "Feature",
      "type": "object"
    },
    "Persona": {
      "description": "A user type whose id can differ from its display name.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "Persona",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
