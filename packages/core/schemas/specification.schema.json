      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scenario_ref": {
          "title": "Scenario Ref",
          "type": "string"
        },
        "persona_ref": {
          "title": "Persona Ref",
          "type": "string"
        },
        "fixtures": {
          "items": {
            "type": "string"
          },
          "title": "Fixtures",
          "type": "array"
        },
        "num_trials": {
          "default": 3,
          "title": "Num Trials",
          "type": "integer"
        },
        "behaviour_refs": {
          "items": {
            "type": "string"
          },
          "title": "Behaviour Refs",
          "type": "array"
        },
        "max_turns": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Max Turns",
          "type": "integer"
        },
        "timeout_minutes": {
          "default": 15,
          "exclusiveMinimum": 0,
          "title": "Timeout Minutes",
          "type": "integer"
        },
        "response_wait_ms": {
          "default": 300000,
          "exclusiveMinimum": 0,
          "title": "Response Wait Ms",
          "type": "integer"
        },
        "max_run_retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Run Retries"
        },
        "user_agent_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Agent Model"
        }
      },
      "required": [
        "id",
        "scenario_ref",
        "persona_ref"
      ],
      "title": "Task",
      "type": "object"
    }
