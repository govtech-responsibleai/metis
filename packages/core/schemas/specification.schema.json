        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "measured": {
          "default": false,
          "title": "Measured",
          "type": "boolean"
        },
        "criteria": {
