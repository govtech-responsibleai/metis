        "id",
        "name",
        "description"
      ],
      "title": "Behaviour",
      "type": "object"
    },
    "Criterion": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "grader_fqn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grader Fqn"
        },
        "grader_args": {
          "additionalProperties": true,
          "title": "Grader Args",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "ExperimentDefaults": {
      "additionalProperties": false,
