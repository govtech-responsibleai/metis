# METIS environment. Copy this file to the repository root as `.env`.
#
# One .env serves metis wizard, metis engine, and the API. Exported values win over this file.
# See docs/guide/models.md for each role, its fallback, and the recommended models.

# Read another file in place of this one. Export it in the shell, because a command reads it
# before it looks for .env.
# METIS_ENV_FILE=/path/to/workshop.env

# The log level of operational events on stderr: DEBUG, INFO, WARNING, or ERROR.
# Unset -> WARNING.
# METIS_LOG_LEVEL=INFO

# ── Models ─────────────────────────────────────────────────────────────────

# Shared OpenAI-compatible gateway. Every role uses it when the role has no override.
# Leave OPENAI_BASE_URL unset to use the default OpenAI endpoint.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://your-gateway/v1

# The model of every chat role (Interview, user agent, runner agent, judge).
# A role variable below wins over it. Unset -> gpt-6-luna.
# DEFAULT_MODEL=your-model

# Interview (metis wizard and the API). Required to start an Interview.
# INTERVIEW_MODEL=your-interview-model        # unset -> DEFAULT_MODEL
# INTERVIEW_API_KEY=your-interview-key        # unset -> OPENAI_API_KEY
# INTERVIEW_BASE_URL=https://your-gateway/v1  # unset -> OPENAI_BASE_URL

# User agent (the simulated user). Affects scores.
# The Specification can set defaults.user_agent_model and Task.user_agent_model.
# USER_AGENT_MODEL=your-user-agent-model        # unset -> DEFAULT_MODEL
# USER_AGENT_API_KEY=your-user-agent-key        # unset -> OPENAI_API_KEY
# USER_AGENT_BASE_URL=https://your-gateway/v1   # unset -> OPENAI_BASE_URL
# USER_AGENT_MAX_TOKENS=4096   # unset/empty -> max_tokens omitted (provider default)
# USER_AGENT_TEMPERATURE=0.7   # unset/empty -> temperature omitted (provider default)

# Runner agent (the generic runners). Affects scores.
# The Specification can set defaults.runner_agent_model. Unset -> the user agent model.
# RUNNER_AGENT_MODEL=your-runner-model
# RUNNER_AGENT_API_KEY=your-runner-agent-key        # unset -> USER_AGENT_API_KEY -> OPENAI_API_KEY
# RUNNER_AGENT_BASE_URL=https://your-gateway/v1     # unset -> USER_AGENT_BASE_URL -> OPENAI_BASE_URL

# Judge (model-based graders only). Affects scores.
# The Specification can set defaults.judge_model and grader_args.model.
# JUDGE_MODEL=your-judge-model                   # unset -> DEFAULT_MODEL
# JUDGE_API_KEY=your-judge-api-key               # unset -> OPENAI_API_KEY
# JUDGE_BASE_URL=https://your-judge-gateway/v1   # unset -> OPENAI_BASE_URL
# The largest estimated request of one judge call (tokens). grader_args.max_input_tokens wins.
# JUDGE_MAX_INPUT_TOKENS=128000                  # unset -> 128000

# Embeddings (metis-testbed only). It skips DEFAULT_MODEL, because it needs an embedding model.
# EMBEDDING_MODEL=your-embedding-model           # unset -> text-embedding-3-large
# EMBEDDING_API_KEY=your-embedding-key           # unset -> OPENAI_API_KEY
# EMBEDDING_BASE_URL=https://your-gateway/v1     # unset -> OPENAI_BASE_URL

# Decision grader live tests: use direct TypeSafe and OpenAI keys.
# TYPESAFE_API_KEY=your-typesafe-api-key
# For engine runs with provider: typesafe, set JUDGE_API_KEY to the TypeSafe key
# and JUDGE_BASE_URL=https://api.typesafe.ai/v1. Set grader_args.model=jev-latest.
# For provider: openai, use the OpenAI gateway and grader_args.model=gpt-6-luna.

# Interview context limit and reserved maximum output (tokens).
# Set the context limit from the selected provider model configuration.
INTERVIEW_CONTEXT_TOKENS=128000
INTERVIEW_OUTPUT_TOKENS=16384

# ── API process ────────────────────────────────────────────────────────────

# The API starts when a model setting is missing. GET /api/v1/models then reports the missing
# variables, and the Interview routes return 503 model_unavailable.
PORT=8001
# The API listens on 127.0.0.1. Login is off by default, so set HOST=0.0.0.0 only on a trusted
# network, or turn login on with METIS_LOGIN below.
# HOST=127.0.0.1
# The SQLAlchemy URL of the database. Unset -> sqlite:///<project>/evaluations/metis.db.
# METIS_DATABASE_URL=sqlite:////path/to/metis.db
# 1 lets the connection check of the web app reach the target, and 0 stops it. Unset -> on only
# when HOST is this computer. On a shared server it sends a request to any URL that a user types.
# METIS_API_CONNECTION_CHECK=0

# Experiments. Each value is a whole number of 1 or more. See docs/guide/docker.md.
# The experiments that run at the same time, for all users. A start beyond it waits in a queue.
# METIS_API_ENGINE_MAX_RUNS=4
# The concurrency of a run whose request gives none, and the most that a request can ask for.
# The server makes up to MAX_RUNS x concurrency model calls at the same time.
# METIS_API_ENGINE_CONCURRENCY=1
# METIS_API_ENGINE_MAX_CONCURRENCY=8
# The seconds that an evaluate waits for traces in Langfuse, by default and at most.
# METIS_API_LANGFUSE_TIMEOUT=180
# METIS_API_MAX_LANGFUSE_TIMEOUT=600
# The seconds that a shutdown waits for the runs to stop, in all. The queue is lost on restart.
# METIS_API_STOP_TIMEOUT=30

# Login for a server that many people use. Unset or 0 -> login is off and each route is open.
# With 1, each /api route needs a login session. See docs/guide/wizard/api.md.
# METIS_LOGIN=1
# Participants type the join token on the login page to make a user account.
# METIS_JOIN_TOKEN=a-long-random-value
# Your own token for the admin API. Keep it secret. It must differ from the join token.
# METIS_ADMIN_TOKEN=a-different-long-random-value
# The admin user account. Set both or neither. Each token and the admin need METIS_LOGIN=1.
# METIS_ADMIN_USERNAME=workshop-lead
# METIS_ADMIN_PASSWORD=a-long-random-value
# Variables that each logged-in user can copy into a .env file for the METIS CLI, separated by
# commas. Each user can read their values, so never list a model provider key. Needs METIS_LOGIN=1.
# The API does not start with a METIS_ name or a name that is there two times.
# METIS_WORKSHOP_ENV=LANGFUSE_PUBLIC_KEY,LANGFUSE_SECRET_KEY,LANGFUSE_BASE_URL

# ── Langfuse ───────────────────────────────────────────────────────────────

# The Langfuse of the system under test. metis engine reads the target's traces from it.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://your-langfuse     # unset -> LANGFUSE_HOST -> https://cloud.langfuse.com
# LANGFUSE_HOST=https://your-langfuse         # the older name of LANGFUSE_BASE_URL
# The seconds of each request to this Langfuse.
# LANGFUSE_TIMEOUT=5
# metis engine grades a trial when Langfuse has stored nothing new for it for this many seconds.
# Raise it if your application sends traces late.
# LANGFUSE_METIS_QUIET_SECONDS=30

# The METIS-internal Langfuse. The wizard and the API trace their Interview model calls to it,
# and metis engine traces its simulation and judge model calls to it, only when all three are
# set. They never use the LANGFUSE_* values above.
# METIS_INTERNAL_LANGFUSE_PUBLIC_KEY=pk-lf-...
# METIS_INTERNAL_LANGFUSE_SECRET_KEY=sk-lf-...
# METIS_INTERNAL_LANGFUSE_BASE_URL=https://your-internal-langfuse

# ── Target ─────────────────────────────────────────────────────────────────

# A target binding names its URLs, keys, and logins as ${NAME}, and metis engine fills each one
# from the environment. The bundled toy app binding and the demo target read this one.
# TOYAPP_API_URL=http://127.0.0.1:8000
