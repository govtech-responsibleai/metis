# METIS environment. Copy this file to the repository root as `.env`.
#
# One .env serves metis wizard, metis engine, and the API. Exported values win over this file.
# METIS_ENV_FILE names another file. See docs/guide/models.md for each role, its fallback, and
# the recommended models.

# ── Models ─────────────────────────────────────────────────────────────────

# Shared OpenAI-compatible gateway. Every role uses it when the role has no override.
# Leave OPENAI_BASE_URL unset to use the default OpenAI endpoint.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://your-gateway/v1

# The model of every chat role (Interview, user agent, runner agent, judge).
# A role variable below wins over it. Unset -> gpt-6-luna.
# DEFAULT_MODEL=your-model

# Interview (metis wizard and the API). Required to start an Interview.
# INTERVIEW_MODEL=your-interview-model        # unset -> DEFAULT_MODEL
# INTERVIEW_API_KEY=your-interview-key        # unset -> OPENAI_API_KEY
# INTERVIEW_BASE_URL=https://your-gateway/v1  # unset -> OPENAI_BASE_URL

# User agent (the simulated user). Affects scores.
# The Specification can set defaults.user_agent_model and Task.user_agent_model.
# USER_AGENT_MODEL=your-user-agent-model        # unset -> DEFAULT_MODEL
# USER_AGENT_API_KEY=your-user-agent-key        # unset -> OPENAI_API_KEY
# USER_AGENT_BASE_URL=https://your-gateway/v1   # unset -> OPENAI_BASE_URL
# USER_AGENT_MAX_TOKENS=4096   # unset/empty -> max_tokens omitted (provider default)
# USER_AGENT_TEMPERATURE=0.7   # unset/empty -> temperature omitted (provider default)

# Runner agent (the generic runners). Affects scores.
# The Specification can set defaults.runner_agent_model. Unset -> the user agent model.
# RUNNER_AGENT_MODEL=your-runner-model
# RUNNER_AGENT_API_KEY=your-runner-agent-key        # unset -> USER_AGENT_API_KEY -> OPENAI_API_KEY
# RUNNER_AGENT_BASE_URL=https://your-gateway/v1     # unset -> USER_AGENT_BASE_URL -> OPENAI_BASE_URL

# Judge (model-based graders only). Affects scores.
# The Specification can set defaults.judge_model and grader_args.model.
# JUDGE_MODEL=your-judge-model                   # unset -> DEFAULT_MODEL
# JUDGE_API_KEY=your-judge-api-key               # unset -> OPENAI_API_KEY
# JUDGE_BASE_URL=https://your-judge-gateway/v1   # unset -> OPENAI_BASE_URL

# Interview context limit and reserved maximum output (tokens).
# Set the context limit from the selected provider model configuration.
INTERVIEW_CONTEXT_TOKENS=128000
INTERVIEW_OUTPUT_TOKENS=16384

# ── API process ────────────────────────────────────────────────────────────

# The API starts when a model setting is missing. GET /api/v1/models then reports the missing
# variables, and the Interview routes return 503 model_unavailable.
PORT=8001
# HOST=0.0.0.0

# ── Langfuse ───────────────────────────────────────────────────────────────

# The Langfuse of the system under test. metis engine reads the target's traces from it.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://your-langfuse

# The METIS-internal Langfuse. The wizard and the API trace their Interview model calls to it,
# and metis engine traces its simulation and judge model calls to it, only when all three are
# set. They never use the LANGFUSE_* values above.
# METIS_INTERNAL_LANGFUSE_PUBLIC_KEY=pk-lf-...
# METIS_INTERNAL_LANGFUSE_SECRET_KEY=sk-lf-...
# METIS_INTERNAL_LANGFUSE_BASE_URL=https://your-internal-langfuse
